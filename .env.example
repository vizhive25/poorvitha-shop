DATABASE_URL="mysql://root:PASSWORD@127.0.0.1:3307/poorvitha"   # local dev: Docker MySQL, see README
ADMIN_PASSWORD="change-me"   # first-run setup password only: used once to create the Owner account
ADMIN_SECRET="long-random-string"
NEXT_PUBLIC_SITE_URL="https://yourdomain.in"

# Razorpay (leave blank to disable online payment; COD still works)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Shiprocket (use the API user from Shiprocket Settings > API; leave blank to disable)
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION=""   # exact pickup address nickname from Shiprocket
SHIPROCKET_WEBHOOK_TOKEN=""
SHIPROCKET_FALLBACK_EMAIL=""    # used when a customer gives no email

# Email (any SMTP provider: Zoho, Gmail app password, Brevo, Resend, etc.). Leave SMTP_HOST blank to disable.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Poorvitha Mobiles <orders@yourdomain.in>"
OWNER_EMAIL=""            # gets a "new order" email

# SMS via MSG91 (needs DLT-approved templates). Leave MSG91_AUTH_KEY blank to disable.
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_CONFIRMED=""   # MSG91 flow/template id; variables VAR1=name VAR2=order id VAR3=amount
MSG91_TEMPLATE_SHIPPED=""     # variables VAR1=name VAR2=order id VAR3=courier VAR4=AWB
