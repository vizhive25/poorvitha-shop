# /etc/nginx/sites-available/poorvitha   (replace yourdomain.in)
# After saving: sudo ln -s /etc/nginx/sites-available/poorvitha /etc/nginx/sites-enabled/ && sudo nginx -t && sudo systemctl reload nginx
# Then get the https certificate:  sudo certbot --nginx -d yourdomain.in -d www.yourdomain.in
server {
    listen 80;
    server_name yourdomain.in www.yourdomain.in;

    client_max_body_size 12m;        # admin image uploads are limited to 5 MB each

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Overwrite (not append to) these so visitors cannot fake their IP; the admin login limiter relies on it.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Optional: let Nginx serve the big static product photos directly.
    location /products/ {
        alias /var/www/poorvitha/public/products/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
