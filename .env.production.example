# Copy to /var/www/poorvitha/.env on the server and fill in. NEVER commit the real file.
NEXT_PUBLIC_SITE_URL="https://yourdomain.in"     # must be set BEFORE `npm run build`
DATABASE_URL="mysql://DBUSER:DBPASSWORD@127.0.0.1:3306/DBNAME"   # from hPanel → Databases (host 127.0.0.1)

# Admin: ADMIN_PASSWORD is only the one-time setup password for creating the Owner account.
ADMIN_PASSWORD="a-long-random-setup-password"
ADMIN_SECRET="64-random-hex-characters"           # signs login cookies: generate with: openssl rand -hex 32

# Lost the Owner password? Set BOTH, restart, sign in with them, choose a new password, then DELETE both.
# ADMIN_RESET_EMAIL=""
# ADMIN_RESET_PASSWORD=""

# Razorpay LIVE keys (leave blank to keep online payment off)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Shiprocket
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION=""
SHIPROCKET_WEBHOOK_TOKEN=""
SHIPROCKET_FALLBACK_EMAIL=""

# Email (SMTP) and SMS (MSG91)
SMTP_HOST="smtp.hostinger.com"   # Hostinger mailbox: port 465 (SSL) or 587; use the full email as username
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Poorvitha Mobiles <orders@yourdomain.in>"
OWNER_EMAIL=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_CONFIRMED=""
MSG91_TEMPLATE_SHIPPED=""

# Cash on Delivery safeguards
COD_MAX_AMOUNT="3000"            # biggest COD order in rupees (0 = no limit); bigger orders must pay online
SHIPROCKET_PICKUP_PINCODE="560023" # used for the PIN code delivery check
